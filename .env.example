ENVIRONMENT=local
# Сколько своих прокси перед Django: 0 — локально без прокси, 1 — Caddy на VPS.
# В staging/production обязательно (см. docs/deploy.md)
TRUSTED_PROXY_COUNT=0
# Версия текста согласия на обработку ПД (дата редакции). В staging/production обязательно
PD_CONSENT_VERSION=local-draft
DEBUG=True
SECRET_KEY=put_your_secret_key_here
ALLOWED_HOSTS=["localhost", "127.0.0.1", "0.0.0.0"]

POSTGRES_DB=yra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=put_your_db_password_here

DATABASE_URL=postgresql://postgres:put_your_db_password_here@localhost:5432/yra

REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

EMAIL_HOST=localhost
EMAIL_PORT=25

AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=

YOOKASSA_SHOP_ID=put_your_shop_id_here
YOOKASSA_SECRET_KEY=put_your_yookassa_secret_here
# Страница «результат оплаты»; бэкенд сам дописывает ?tx=<id транзакции>
YOOKASSA_RETURN_URL=http://localhost:3000/checkout/result

# Секрет Cloudflare Turnstile. Пусто локально — тестовый ключ «всегда успех».
# В staging/production обязателен, в production тестовые ключи запрещены
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Уведомления менеджерам (заявки с сайта, брони на платные события,
# возвраты на ручной разбор): бот, чат и адрес админки для ссылки на заявку.
# Пусто — не отправляются, в лог пишется ошибка. В production обязательны
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
ADMIN_BASE_URL=http://localhost:8000

# Минут на «Подтвердить оплату» для брони на платное событие (по умолчанию 30)
EVENT_PENDING_PAYMENT_TTL_MINUTES=30
