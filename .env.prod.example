# Шаблон прод-окружения для docker-compose.prod.yml (docs/deploy.md).
# На сервере: cp .env.prod.example .env.prod и заменить все put_...
# .env.prod в git не коммитится.

ENVIRONMENT=production
DEBUG=False
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=put_a_long_random_string_here

# Домен API без https:// — по нему Caddy выпускает сертификат
DOMAIN=api.example.ru
ALLOWED_HOSTS=["api.example.ru"]
CSRF_TRUSTED_ORIGINS=["https://api.example.ru"]
# Адрес фронтенда
CORS_ALLOWED_ORIGINS=["https://example.ru"]

# Интернет → Caddy → gunicorn: один свой прокси
TRUSTED_PROXY_COUNT=1

# Процессы gunicorn: ≈ число ядер CPU (у каждого 4 потока)
GUNICORN_WORKERS=2

# База живёт в том же compose, наружу не открыта.
# DATABASE_URL собирается в docker-compose.prod.yml из этих трёх
POSTGRES_DB=yra
POSTGRES_USER=yra
POSTGRES_PASSWORD=put_a_long_random_password_here

# Почта для кодов входа (SMTP вашего почтового сервиса)
EMAIL_HOST=smtp.example.ru
EMAIL_PORT=587
EMAIL_HOST_USER=put_smtp_user_here
EMAIL_HOST_PASSWORD=put_smtp_password_here
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.ru

YOOKASSA_SHOP_ID=put_your_shop_id_here
YOOKASSA_SECRET_KEY=put_your_yookassa_secret_here
YOOKASSA_RETURN_URL=https://example.ru/checkout/result

CAPTCHA_SECRET_KEY=put_your_captcha_secret_here

# Пусто — файлы хранятся на диске сервера (том media).
# Заполнить, если переедем в S3-совместимое хранилище
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
